# Copy to .env. Never commit keys. Compatible with OpenAI-style /chat/completions.
TESTFIX_PROVIDER=replay
TESTFIX_RUNNER=process
TESTFIX_LLM_BASE_URL=
TESTFIX_LLM_MODEL=
TESTFIX_LLM_API_KEY=
TESTFIX_LLM_TIMEOUT=120
TESTFIX_LLM_MAX_TOKENS=4096
# Optional: read legacy .env directly without copying its secret.
TESTFIX_LEGACY_ENV=
TESTFIX_LEGACY_BASE_VAR=OPENAI_BASE_URL
TESTFIX_LEGACY_MODEL_VAR=OPENAI_MODEL
TESTFIX_LEGACY_KEY_VAR=OPENAI_API_KEY
# Ollama /api/chat
TESTFIX_OLLAMA_URL=http://127.0.0.1:11434
TESTFIX_OLLAMA_MODEL=
# AgentArts documented runtime invocation; body contract belongs to this project.
TESTFIX_AGENTARTS_URL=
TESTFIX_AGENTARTS_API_KEY=
TESTFIX_DOCKER_IMAGE=python:3.13-slim
# Optional external WCTP source dependency; obtain authorization separately and configure its root.
# The adapter verifies pinned SHA-256 hashes before loading its graph-only modules.
TESTFIX_WCTP_ROOT=

